<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <!-- 125A hardware palette: accessible text contrast, restrained amber. -->
    <color name="Dark" rgba="#101318FF"/>
    <color name="Rim" rgba="#667079FF"/>
    <color name="Panel" rgba="#272D35FF"/>
    <color name="Inset" rgba="#131920FF"/>
    <color name="LCD" rgba="#0C1924FF"/>
    <color name="Frame" rgba="#77828DFF"/>
    <color name="Accent" rgba="#E4AB56FF"/>
    <color name="AccentDim" rgba="#6E5638FF"/>
    <color name="Silver" rgba="#EDF1F5FF"/>
    <color name="Muted" rgba="#B9C2CCFF"/>
    <color name="Green" rgba="#93D7AAFF"/>
    <color name="Warning" rgba="#D65C41FF"/>
  </colors>
  <!-- Explicit Segoe UI typography, avoiding the undersized SDK defaults. -->
  <fonts>
    <font name="BrandFace" font-name="Segoe UI" size="25" bold="true"/>
    <font name="SectionFace" font-name="Segoe UI" size="14" bold="true"/>
    <font name="ControlFace" font-name="Segoe UI" size="12" bold="true"/>
    <font name="NumberFace" font-name="Segoe UI" size="12" bold="true"/>
    <font name="MicroFace" font-name="Segoe UI" size="11"/>
  </fonts>
  <template name="view" class="CViewContainer" origin="0, 0" size="1024, 692" background-color="Dark" background-color-draw-style="filled" mouse-enabled="true" transparent="false">
    <!-- 2-pixel physical chassis edging: all geometry stays in 1024x692. -->
    <view class="CViewContainer" origin="14, 14" size="996, 85" background-color="Rim" background-color-draw-style="filled" transparent="false" mouse-enabled="false"/>
